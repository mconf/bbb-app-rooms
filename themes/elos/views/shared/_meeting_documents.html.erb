<%# Contents of the documents dropdown of a meeting, loaded via XHR

  The documents are split in two groups: the ones of the session, which exist even when
  the meeting was not recorded, and the ones made from the recording.
%>
<% ai_document_types = %w[ai_summary transcription] %>
<%# Display order of the documents of the meeting, all of them listed as text documents %>
<% text_document_types = %w[shared_notes engagement_report participants_list] %>

<% internal_meeting_id = @meeting[:internalMeetingID] %>

<%# What the user is allowed to see is decided here and never taken from the request,
    otherwise whoever calls the endpoint could turn a feature on for themselves. When the
    meeting ended is the one thing the request is trusted for, and it decides nothing
    beyond whether a spinner is shown %>
<% can_download_documents = can_edit?(@user, @room) %>
<% ai_documents_enabled = ai_documents_enabled?(@user, @room, internal_meeting_date(internal_meeting_id)) %>

<% recording_deleted = recording_deleted?(@recording) %>
<% has_recording = @recording.present? && !recording_deleted && !hide_recordings_history?(@room) %>
<%# BBB answers with no playbacks both while it is still working on the recording and
    when the recording is hidden, so only the state tells the two apart %>
<% recording_processing = has_recording && @recording[:state] == 'processing' %>
<% has_insufficient_audio = @recording.present? && @recording[:metadata].present? && @recording[:metadata][:'insufficient-audio'] == 'true' %>

<%# Only a published recording can be downloaded %>
<% playback_download = has_recording && @recording[:published] ? download_format(@recording) : nil %>
<% recording_download_url = playback_download.present? && can_download_recording?(@user, @room) ? playback_url(@room, @recording[:recordID], playback_download) : nil %>

<%# Deleting the recording is offered on its own row, to whoever may edit the meeting,
    once BBB is done with it %>
<% can_delete_recording = has_recording && !recording_processing && can_edit?(@user, @room) %>
<% recording_delete_url = can_delete_recording ? recording_delete_path(@room, record_id: @recording[:recordID]) : nil %>

<%# The column earns its place only when it holds something for this user: whoever may
    edit the meeting always has the recording itself to act on, everyone else only when
    there is a download, or one on its way %>
<% has_recording_column = has_recording && (can_download_documents || recording_download_url.present? || recording_processing) %>

<%# Status of the last request for the documents of the recording %>
<% cached_statuses = ai_document_types.map { |type| @ai_artifact_cache_status&.dig(type) }.compact %>
<% has_pending = cached_statuses.include?('pending') %>
<% has_error = cached_statuses.include?('error') %>
<% all_recording_documents_available = ai_document_types.all? { |type| @recording_documents[type].present? } %>

<%# Only on its way when the pipeline was given something to make it from %>
<% session_ai_status = @has_session_objects && session_documents_generating?(@meeting[:endTime], @meeting[:running]) ? :pending : nil %>

<% recording_ai_status = has_pending ? :pending : ((has_error || has_insufficient_audio) ? :error : nil) %>
<% recording_ai_error = t("meetings.meeting_data_download.#{has_insufficient_audio ? 'ai_artifacts_insufficient_audio_error' : 'ai_artifacts_error_tooltip'}") %>

<%# The header comes with the menu, see 'shared/documents_dropdown', so only the columns
    are replaced when these contents arrive %>
<div class="documents-columns">
  <%# Whoever cannot download the documents can only be here for the recording %>
  <% if can_download_documents %>
    <div class="documents-column" id="text-documents">
      <div class="column-header">
        <%= icon_text_documents %>
        <div class="label"><%= t('meetings.meeting_data_download.text_documents') %></div>
      </div>

      <div class="documents-list">
        <% if ai_documents_enabled %>
          <% ai_document_types.each do |type| %>
            <%= render 'shared/document_item', type: type, href: @session_documents[type], ai: true,
              status: session_ai_status %>
          <% end %>
        <% end %>

        <% text_document_types.each do |type| %>
          <%= render 'shared/document_item', type: type, href: @meeting_documents[type] %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if has_recording_column %>
    <div class="documents-column" id="recording-documents">
      <div class="column-header">
        <%= icon_recording_documents %>
        <div class="label"><%= t('meetings.meeting_data_download.recording_documents') %></div>
      </div>

      <div class="documents-list">
        <% if ai_documents_enabled %>
          <% ai_document_types.each do |type| %>
            <%= render 'shared/document_item', type: type, href: @recording_documents[type], ai: true,
              status: recording_ai_status, status_tooltip: recording_ai_error %>
          <% end %>
        <% end %>

        <%# The hourglass tells the recording is on its way, it is not ready to download yet %>
        <%= render 'shared/document_item', type: 'recording', href: recording_download_url,
          status: recording_processing ? :processing : nil, status_tooltip: t('meetings.recording.processing'),
          delete_path: recording_delete_url %>

        <%# The documents of the recording are the ones generated on demand, and there is
            nothing to generate them from until BBB is done with it %>
        <% if ai_documents_enabled && !recording_processing && !(all_recording_documents_available || has_insufficient_audio) %>
          <% requestable_types = ai_document_types.reject { |type| @recording_documents[type].present? } %>
          <%# While they are being generated the button stays, disabled, saying so %>
          <button class="request-ai-artifacts-btn"
            data-request-endpoint="<%= room_scheduled_meeting_internal_request_ai_artifacts_path(@room, @meeting[:meetingID], internal_meeting_id) %>"
            data-requested-types="<%= requestable_types.to_json %>"
            data-text-requesting="<%= t('meetings.meeting_data_download.requesting_ai_artifacts') %>"
            <%= 'disabled' if has_pending || has_error %>>
            <% if has_pending %>
              <%= t('meetings.meeting_data_download.requesting_ai_artifacts') %>
            <% else %>
              <%= t('meetings.meeting_data_download.request_ai_artifacts') %>
            <% end %>
          </button>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
