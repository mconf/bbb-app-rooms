<%# One document line inside the documents dropdown

  Locals:
    type (string): document type, gives the icon and the label
    href (string): where the download points to, nil when it is not available yet
    ai (boolean): mark the document as generated by AI
    status (symbol): :pending shows a spinner, :processing an hourglass, :error the
      error icon
    status_tooltip (string): message shown by the icon of the status
%>
<% href = local_assigns.fetch(:href, nil) %>
<% ai = local_assigns.fetch(:ai, false) %>
<% status = local_assigns.fetch(:status, nil) %>
<% status_tooltip = local_assigns.fetch(:status_tooltip, nil) %>

<%# Nothing on its way and nothing to download %>
<% unavailable = href.blank? && status.nil? %>

<% label = capture do %>
  <span class="document-label">
    <%= document_icon(type) %>
    <span class="label"><%= t("meetings.meeting_data_download.documents.#{type}") %></span>
    <%# The AI mark comes off a document that does not exist: there is nothing it made,
        and it would be the one thing left with a color on a row that reads as unavailable %>
    <%= icon_ai_generated if ai && !unavailable %>
  </span>
<% end %>

<%# 'ai' marks the documents that can be generated on demand, the request uses it to
    know which ones to ask for %>
<% item_class = ai ? 'document-item ai' : 'document-item' %>

<% if href.present? %>
  <%= link_to href, class: "#{item_class} downloadable", target: (browser.safari? ? '_self' : '_blank'),
    data: { 'document-type': type, 'tracking-id': "lti-download-#{type.tr('_', '-')}", 'institution-guid': "#{@institution_guid}" } do %>
    <%= label %>
    <%= icon_download %>
  <% end %>
<% else %>
  <%# The row is dimmed and says so %>
  <div class="<%= item_class %><%= ' unavailable' if unavailable %>" data-document-type="<%= type %>">
    <%= label %>
    <% if status == :pending %>
      <span class="document-spinner"><%= icon_progress_activity %></span>
    <% elsif status == :processing %>
      <%= icon_recording_load(title: status_tooltip, class: 'document-status') %>
    <% elsif status == :error %>
      <span data-bs-toggle="tooltip" data-bs-placement="left" title="<%= status_tooltip %>">
        <%= icon_info_circle(class: 'color-error document-status') %>
      </span>
    <% else %>
      <%= icon_document_unavailable(title: t('meetings.meeting_data_download.document_unavailable'),
        class: 'document-status') %>
    <% end %>
  </div>
<% end %>
